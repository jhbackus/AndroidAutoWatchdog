<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="CAR AI" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Handsfree ChatGPT voor Android Auto. Open CAR AI in de auto en tik op Start om via de automicrofoon te praten." />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="Realtime broker WebSocket-URL" android:textStyle="bold" />
        <EditText android:id="@+id/brokerUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="wss://jouwdomein.nl/chatgpt-auto" android:inputType="textUri" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Broker-token" android:textStyle="bold" />
        <EditText android:id="@+id/brokerToken" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Broker-token" android:inputType="textPassword" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Stem" android:textStyle="bold" />
        <Spinner android:id="@+id/voice" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/mediaAccess" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="Mediatoegang voor Spotify / Roon ARC" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Schakel CAR AI in bij Meldings-/mediatoegang zodat actieve Spotify- en Roon ARC-sessies bediend en na een gesprek hervat kunnen worden." />
        <Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="Instellingen opslaan" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Voorbeelden: ‘Navigeer naar Damrak 1 Amsterdam’, ‘Bel Gwendolien’, ‘Volgende nummer op Spotify’, ‘Pauzeer Roon ARC’, of stel gewoon een vraag aan ChatGPT." />
    </LinearLayout>
</ScrollView>
